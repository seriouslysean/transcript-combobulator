# ── Required: Whisper Settings ──
WHISPER_PROMPT="This is a recording of a Dungeons & Dragons 5e live play session. Focus on transcribing actual spoken words and ignore non-speech sounds like laughs, sighs, or background noise."

# ── Required: Speaker Mappings ──
# Format: TRANSCRIPT_N_[FIELD] where N is an index number

# Transcript 1: DM Session Example
TRANSCRIPT_1_USERNAME=dm
TRANSCRIPT_1_NAME="DM"
TRANSCRIPT_1_LABEL="DM"
TRANSCRIPT_1_DESCRIPTION="Dungeon Master"

# Transcript 2: Player 1 Barbarian Example
TRANSCRIPT_2_USERNAME=barbarian
TRANSCRIPT_2_NAME="Player 1"
TRANSCRIPT_2_LABEL="Barbarian"
TRANSCRIPT_2_DESCRIPTION="Goliath Barbarian"

# Transcript 3: Player 2 Druid Example
TRANSCRIPT_3_USERNAME=druid
TRANSCRIPT_3_NAME="Player 2"
TRANSCRIPT_3_LABEL="Druid"
TRANSCRIPT_3_DESCRIPTION="Human Druid"

# Transcript 4: Player 3 Rogue Example
TRANSCRIPT_4_USERNAME=rogue
TRANSCRIPT_4_NAME="Player 3"
TRANSCRIPT_4_LABEL="Rogue"
TRANSCRIPT_4_DESCRIPTION="Halfling Rogue"

# ── Combination Settings ──
DEDUPE_STRATEGY=consecutive   # consecutive | global | none (applies to VTTs and the combined file)
# DEDUPE_WINDOW_SECONDS=2.0   # consecutive: max gap for a repeat to count as a duplicate
INCLUDE_TIMESTAMPS=false
SKIP_FILTERS="[AUDIO OUT],[BLANK_AUDIO]"
CHUNKS=2

# ── Optional: Override Whisper/VAD Defaults ──
# Uncomment to override project defaults from config.py
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cpu
# WHISPER_FP16=false
# WHISPER_LANGUAGE=en
# WHISPER_TEMPERATURE=0.0  # A list (0.0,0.2,0.4) enables whisper's fallback re-decode
# WHISPER_BEAM_SIZE=1
# WHISPER_WORD_TIMESTAMPS=false
# WHISPER_CONDITION_ON_PREVIOUS=false
# WHISPER_CARRY_INITIAL_PROMPT=true  # Reapply configured vocabulary to long islands
# WHISPER_NO_SPEECH_THRESHOLD=0.6
# WHISPER_LOGPROB_THRESHOLD=-1.0
# WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
# WHISPER_CONFIDENCE_THRESHOLD=50.0
# SAMPLE_RATE=16000
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_DURATION=0.25  # Preserve short replies and spoken numbers
# VAD_MIN_SILENCE_DURATION=3.0  # Longer speech islands reduce Whisper calls
# PADDING_SECONDS=0.3

# ── Optional: Audio Stage Defaults ──
# VAD_THREADS=1            # Silero is frame-serial; more threads is slower
# VAD_BACKEND=onnx         # onnx (bounded memory) or jit (TorchScript); same weights, same regions

# ── Optional: Override Parallel Processing Defaults ──
# PARALLEL_JOBS=2          # Max concurrent files (default: 2)
# TORCH_THREADS=0          # Threads per Whisper worker (0 = auto-detect)
# WORKER_NICE=10           # Lower worker priority; 0 keeps normal priority

# ── Optional: Batch Run Guards (defaults shown) ──
# MEMORY_GUARD=true          # Lower the worker count if the model won't fit in RAM
# MEMORY_GUARD_FRACTION=0.85 # Share of physical RAM the workers may claim
# MAPPING_PRECHECK=true      # Validate TRANSCRIPT_N_* before transcribing
# LOG_FILE=                  # Empty = tmp/output/<session>/<session>.log; none = off
# FAIL_ON_PARTIAL_TRANSCRIPTION=true  # Any failed chunk fails the file so a rerun retries it
# ALLOW_SILENT_TRACKS=true            # A track with no speech yields an empty transcript
