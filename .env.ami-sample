# ── Whisper Settings ──
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_FP16=false
WHISPER_LANGUAGE=en
WHISPER_TEMPERATURE=0.0
WHISPER_BEAM_SIZE=1
WHISPER_WORD_TIMESTAMPS=false
WHISPER_CONDITION_ON_PREVIOUS=false
WHISPER_CARRY_INITIAL_PROMPT=true
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_CONFIDENCE_THRESHOLD=50.0

SAMPLE_RATE=16000
TRANSCRIPTION_MODE=vad
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=3.0
PADDING_SECONDS=0.3
WHISPER_PROMPT="This is a recording of an informal meeting between four people. Focus on transcribing actual spoken words and ignore non-speech sounds like laughs, sighs, or background noise."

# ── Speaker Mappings ──
# AMI Meeting Corpus EN2002b, one headset per speaker (`make sample-ami`).
# Source and licence: samples/ami/NOTICE.md
TRANSCRIPT_1_USERNAME="ami_a"
TRANSCRIPT_1_NAME="Participant A"
TRANSCRIPT_1_LABEL="Speaker A"
TRANSCRIPT_1_DESCRIPTION="AMI EN2002b headset 0"

TRANSCRIPT_2_USERNAME="ami_b"
TRANSCRIPT_2_NAME="Participant B"
TRANSCRIPT_2_LABEL="Speaker B"
TRANSCRIPT_2_DESCRIPTION="AMI EN2002b headset 1"

TRANSCRIPT_3_USERNAME="ami_c"
TRANSCRIPT_3_NAME="Participant C"
TRANSCRIPT_3_LABEL="Speaker C"
TRANSCRIPT_3_DESCRIPTION="AMI EN2002b headset 2"

TRANSCRIPT_4_USERNAME="ami_d"
TRANSCRIPT_4_NAME="Participant D"
TRANSCRIPT_4_LABEL="Speaker D"
TRANSCRIPT_4_DESCRIPTION="AMI EN2002b headset 3"

# ── Combination Settings ──
INCLUDE_TIMESTAMPS=true
SKIP_FILTERS="[AUDIO OUT],[BLANK_AUDIO]"
CHUNKS=1
