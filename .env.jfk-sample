# ── Whisper Settings ──
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_FP16=false
WHISPER_LANGUAGE=en
WHISPER_TEMPERATURE=0.0
WHISPER_BEAM_SIZE=1
WHISPER_WORD_TIMESTAMPS=false
WHISPER_CONDITION_ON_PREVIOUS=false
WHISPER_CARRY_INITIAL_PROMPT=true
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_CONFIDENCE_THRESHOLD=50.0

SAMPLE_RATE=16000
TRANSCRIPTION_MODE=vad
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=3.0
PADDING_SECONDS=0.3
WHISPER_PROMPT="This is a historical audio recording of President John F. Kennedy. Focus on transcribing actual spoken words clearly and accurately."

# ── Speaker Mappings ──
# Username extraction regex for JFK sample folders (e.g., jfk_1, jfk_2)
USERNAME_EXTRACTION_REGEX="^(.+)"  # e.g., username -> username

# JFK Test Audio Files
TRANSCRIPT_1_USERNAME="jfk_1"
TRANSCRIPT_1_NAME="President Kennedy"
TRANSCRIPT_1_LABEL="John F. Kennedy"
TRANSCRIPT_1_DESCRIPTION="35th President of the United States"

TRANSCRIPT_2_USERNAME="jfk_2"
TRANSCRIPT_2_NAME="President Kennedy"
TRANSCRIPT_2_LABEL="John F. Kennedy"
TRANSCRIPT_2_DESCRIPTION="35th President of the United States"

TRANSCRIPT_3_USERNAME="jfk_3"
TRANSCRIPT_3_NAME="President Kennedy"
TRANSCRIPT_3_LABEL="John F. Kennedy"
TRANSCRIPT_3_DESCRIPTION="35th President of the United States"

TRANSCRIPT_4_USERNAME="jfk_4"
TRANSCRIPT_4_NAME="President Kennedy"
TRANSCRIPT_4_LABEL="John F. Kennedy"
TRANSCRIPT_4_DESCRIPTION="35th President of the United States"

TRANSCRIPT_5_USERNAME="jfk_5"
TRANSCRIPT_5_NAME="President Kennedy"
TRANSCRIPT_5_LABEL="John F. Kennedy"
TRANSCRIPT_5_DESCRIPTION="35th President of the United States"

TRANSCRIPT_6_USERNAME="jfk_padded"
TRANSCRIPT_6_NAME="President Kennedy"
TRANSCRIPT_6_LABEL="John F. Kennedy"
TRANSCRIPT_6_DESCRIPTION="35th President of the United States"

# ── Combination Settings ──
DEDUPE_STRATEGY=consecutive
INCLUDE_TIMESTAMPS=true
SKIP_FILTERS="[AUDIO OUT],[BLANK_AUDIO]"
CHUNKS=1
